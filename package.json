{
  "name": "seco-mcp",
  "version": "1.0.1",
  "mcpName": "io.github.aidandevv/seco",
  "description": "a local professional identity engine with guided review-before-save intake",
  "bin": {
    "seco": "packages/mcp-server/dist/index.js",
    "seco-mcp": "packages/mcp-server/dist/index.js"
  },
  "workspaces": [
    "packages/core",
    "packages/mcp-server",
    "packages/web-ui"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/core && npm run build --workspace=packages/web-ui && npm run build --workspace=packages/mcp-server",
    "test": "npm run test --workspaces --if-present",
    "release:check": "npm test && npm run build && npm audit --omit=dev --cache .npm-cache && npm pack --dry-run --cache .npm-cache && npm run release:smoke:tarball",
    "release:smoke:tarball": "node scripts/smoke-packed-tarball.mjs",
    "release:stage:mcpb": "node scripts/stage-mcpb.mjs",
    "release:pack:mcpb": "npm run release:stage:mcpb && mcpb pack dist/mcpb/seco",
    "clean": "rm -rf packages/core/dist packages/mcp-server/dist packages/web-ui/dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.33.0",
    "@modelcontextprotocol/ext-apps": "^1.7.2",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@seco/core": "file:packages/core",
    "better-sqlite3": "^11.0.0",
    "express": "^4.19.0",
    "multer": "^2.0.0",
    "openai": "^4.52.0",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "files": [
    "packages/mcp-server/dist",
    "packages/core/dist",
    "packages/core/package.json",
    "packages/web-ui/dist",
    "server.json",
    "mcpb/manifest.json",
    "docs/release.md",
    "!packages/**/dist/**/*.test.*",
    "!packages/**/dist/**/*.spec.*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aidandevv/seco.git"
  },
  "keywords": [
    "mcp"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/aidandevv/seco/issues"
  },
  "homepage": "https://github.com/aidandevv/seco#readme"
}
